// ============================================================
// Edge Case Tests — boundary conditions, unusual inputs
// ============================================================

// --- 1. Division by Zero ---
// Should produce inf/nan or error gracefully
var div_zero = 10 / 0;
print("1. Div by zero: {div_zero}");

// --- 2. Negative Index Access ---
var arr = [10, 20, 30, 40, 50];
// Test accessing beyond end
if (arr.len() > 0) {
    print("2. Array len: {arr.len()}");
}

// --- 3. Empty Collection Operations ---
var empty_arr = [];
var empty_map = {};
var empty_set = #{};
print("3. Empty collections: arr={empty_arr.len()} map_has_key={empty_map.has("x")} set_has={empty_set.has("x")}");

// --- 4. Nil Operations ---
var nil_val = nil;
var nil_safe = isNil(nil_val);
print("4. Nil checks: {nil_safe}");

// --- 5. String Edge Cases ---
var empty_str = "";
var unicode_str = "Hello 世界 مرحبا 🎉";
var newline_str = "line1\nline2\nline3";
print("5. Strings: empty={empty_str.len()} unicode={unicode_str.len()}");
print("   multiline lines: {newline_str.split("\\n").len()}");

// --- 6. Numeric Edge Cases ---
var max_float = 1.7976931348623157e+308;
var small_float = 2.2250738585072014e-308;
var neg_zero = -0.0;
var pi_approx = 3.14159265358979;
print("6. Numbers: neg_zero={neg_zero} small={small_float}");

// --- 7. Integer Overflow Test ---
var big = 2147483647;
var over = big + 1;
print("7. Overflow: {big} + 1 = {over}");

// --- 8. Boolean Logic Short-circuit ---
var sc_result = false || (1 / 0);
print("8. Short-circuit: {sc_result}");

// --- 9. Multiple Return Values ---
def triple() {
    return [1, 2, 3];
}
var result = triple();
print("9. Triple: {result[0]} {result[1]} {result[2]}");

// --- 10. Nil Return Handling ---
def maybe_nil(flag) {
    if (flag) {
        return "found";
    }
    return nil;
}
var found = maybe_nil(true);
var missing = maybe_nil(false);
print("10. Maybe nil: found={found} missing={missing} isNil={isNil(missing)}");

// --- 11. Empty String Methods ---
var e = "";
print("11. Empty str: len={e.len()} upper='{e.upper()}' lower='{e.lower()}'");

// --- 12. Single Element Collections ---
var single_arr = [42];
var single_map = {};
single_map.set("key", "val");
var single_set = #{42};
print("12. Singles: arr={single_arr[0]} map={single_map.get("key")} set={single_set.size()}");

// --- 13. Self Comparison ---
var x = 0.0;
print("13. NaN-like: {x == x} {isNil(x)}");

// --- 14. Type Coercion ---
var num_str = "123";
var bool_str = "true";
var nil_val2 = nil;
print("14. Types: {typeof(num_str)} {typeof(bool_str)} {typeof(nil_val2)}");

// --- 15. Empty Function ---
def empty_fn() {
    // does nothing
}
empty_fn();
print("15. Empty fn called OK");

// --- 16. Deeply Nested Access ---
var deep = {};
var d1 = {};
var d2 = {};
var d3 = {};
var d4 = {};
d4.set("v", "deep_value");
d3.set("nested", d4);
d2.set("nested", d3);
d1.set("nested", d2);
deep.set("nested", d1);
var leaf = deep.get("nested").get("nested").get("nested").get("nested");
print("16. Deep access: {leaf.get("v")}");

// --- 17. Set Membership with Various Types ---
var s = #{"a", 1, true, nil};
print("17. Mixed set: has_a={s.has("a")} has_1={s.has(1)} has_t={s.has(true)} has_nil={s.has(nil)}");

// --- 18. Map with Nil Key ---
var m = {};
m.set("normal", "value");
print("18. Map: has_normal={m.has("normal")}");

// --- 19. Empty Array Push/Pop ---
var ap = [];
ap.push(1);
ap.push(2);
var popped = ap.pop();
var last = ap.pop();
var empty_pop = nil;
if (ap.len() > 0) {
    empty_pop = ap.pop();
}
print("19. AP: popped={popped} last={last} empty={empty_pop}");

// --- 20. Very Long String ---
var long = "";
var i = 0;
while (i < 10000) {
    long = long + "x";
    i = i + 1;
}
print("20. Long string: len={long.len()}");

print("");
print("=== EDGE CASE TESTS PASSED ===");
