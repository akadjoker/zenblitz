// stress: fibers misuse + class machinery edges
// resume dead fiber → nil (documented), repeatedly
def gen() { yield 1; }
var f = spawn gen;
print("f1:", resume(f), resume(f), resume(f), resume(f));

// error inside fiber — catchable, fiber dies
def boomf() { yield 1; error("fiber-boom"); }
var fb = spawn boomf;
print("f2:", resume(fb));
var (ok1, e1) = pcall(def() { return resume(fb); });
print("f2-err:", ok1 == false);
// a fiber that died from an error is dead: resuming it returns nil,
// exactly like a fiber that finished normally
var (okz, ez) = pcall(def() { return resume(fb); });
print("f2-dead:", okz, ez);

// spawn non-function must be catchable
var (ok2, e2) = pcall(def() { var bad = spawn 42; return resume(bad); });
print("spawn-bad:", ok2 == false);

// send values both ways; the final resume delivers the fiber's RETURN value
def pingpong() {
    var got = yield "ready";
    var got2 = yield "got:" + got;
    return "end:" + got2;
}
var pp = spawn pingpong;
print("pp:", resume(pp), resume(pp, "A"), resume(pp, "B"), resume(pp));

// many nested spawns — fiber creating fibers
def outer_gen() {
    def inner() { yield 10; yield 20; }
    var fi = spawn inner;
    yield resume(fi);
    yield resume(fi);
}
var fo = spawn outer_gen;
print("nested-fiber:", resume(fo), resume(fo));

// -- classes --
// multi-level inheritance chain (field defaults: simple literals only)
class A { var tag = 65; def who() { return "A"; } }
class B : A { def who() { return "B<" + self.tag; } }
class C : B { var extra = 9; }
var c = C();
print("chain:", c.who(), c.tag, c.extra, c is C, c is B, c is A, c is int);
print("names:", classname(c), classname(42), classname("s"), classname(nil), classname([1]));

// static state under loops
class Counter {
    static var n = 0;
    static def bump() { Counter.n += 1; return Counter.n; }
}
foreach (i in 0..100) { Counter.bump(); }
print("static:", Counter.n);
Counter.n = 0;
print("static-reset:", Counter.n, Counter.bump());

// __str__ overload honoured by str()
class Point {
    var x = 1;
    var y = 2;
    def __str__() { return "P({self.x},{self.y})"; }
}
print("str:", str(Point()));

// init with error — instance construction failure is catchable
class Fragile { def init() { error("ctor-fail"); } }
var (ok3, e3) = pcall(def() { return Fragile(); });
print("ctor-err:", ok3 == false);

// method value extracted and called later (bound or not — locked by snapshot)
var p = Point();
var (ok4, r4) = pcall(def() { var mth = p.__str__; return mth(); });
print("method-val:", ok4, r4);

// fields holding functions: obj.fn() resolves methods only (no field
// fallback) — calling requires a two-step through a local. Locked here.
class Holder {
    var fn;
    def init() { self.fn = def() { return "field-fn"; }; }
}
var (okh, eh) = pcall(def() { return Holder().fn(); });
var hf = Holder().fn;
print("field-fn:", okh, hf());

// instance in collections + is checks in comprehension
var objs = [A(), B(), C(), 42, "s"];
var bs = [o for o in objs if o is B];
print("filter-is:", bs.len());

// deep method chains through self-returning methods
class Fluent {
    var v = 0;
    def add(n) { self.v += n; return self; }
}
print("fluent:", Fluent().add(1).add(2).add(3).add(4).v);
