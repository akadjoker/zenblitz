// ============================================================
// Control Flow Tests — loops, breaks, continues, conditionals
// ============================================================

// --- 1. For Loop Variations ---
var sum_for = 0;
for (var i = 0; i < 10; i = i + 1) {
    sum_for = sum_for + i;
}
print("1. For sum(0..9) = {sum_for}");

// --- 2. While Loop ---
var count_while = 0;
while (count_while < 5) {
    count_while = count_while + 1;
}
print("2. While count = {count_while}");

// --- 3. Do-While Loop ---
var count_do = 0;
do {
    count_do = count_do + 1;
} while (count_do < 5);
print("3. Do-while count = {count_do}");

// --- 4. Break in Loop ---
var break_val = 0;
loop {
    break_val = break_val + 1;
    if (break_val >= 5) {
        break;
    }
}
print("4. Break at = {break_val}");

// --- 5. Continue in Loop ---
var cont_sum = 0;
for (var j = 0; j < 10; j = j + 1) {
    if (j % 2 == 1) {
        continue;
    }
    cont_sum = cont_sum + j;
}
print("5. Sum evens(0..9) = {cont_sum}");

// --- 6. Nested Loops ---
var product = 0;
for (var r = 0; r < 3; r = r + 1) {
    for (var c = 0; c < 4; c = c + 1) {
        product = product + 1;
    }
}
print("6. Nested 3x4 = {product}");

// --- 7. Nested Break ---
var outer_done = false;
for (var r = 0; r < 5; r = r + 1) {
    for (var c = 0; c < 5; c = c + 1) {
        if (r == 2 && c == 3) {
            outer_done = true;
            break;
        }
    }
    if (outer_done) {
        break;
    }
}
print("7. Nested break at (2,3)");

// --- 8. Complex Conditionals ---
var grade = 85;
var letter;
if (grade >= 90) {
    letter = "A";
} else if (grade >= 80) {
    letter = "B";
} else if (grade >= 70) {
    letter = "C";
} else if (grade >= 60) {
    letter = "D";
} else {
    letter = "F";
}
print("8. Grade 85 = {letter}");

// --- 9. Chained Ternary-like ---
var a = 10;
var b = 20;
var bigger = (a > b) ? a : b;
print("9. Max(10,20) = {bigger}");

// --- 10. Switch-like via If Chain ---
var day = 3;
var day_name;
if (day == 0) day_name = "Sun";
else if (day == 1) day_name = "Mon";
else if (day == 2) day_name = "Tue";
else if (day == 3) day_name = "Wed";
else if (day == 4) day_name = "Thu";
else if (day == 5) day_name = "Fri";
else day_name = "Sat";
print("10. Day 3 = {day_name}");

// --- 11. Early Returns ---
def abs_val(x) {
    if (x >= 0) {
        return x;
    }
    return -x;
}
print("11. Abs(-42) = {abs_val(-42)} abs(0) = {abs_val(0)} abs(42) = {abs_val(42)}");

// --- 12. Multiple Break Conditions ---
var found = false;
for (var k = 0; k < 100; k = k + 1) {
    if (k * k == 36) {
        found = true;
        break;
    }
}
print("12. Found sqrt(36): {found}");

// --- 13. Infinite Loop with Break ---
var iter = 0;
loop {
    iter = iter + 1;
    if (iter >= 10000) {
        break;
    }
}
print("13. Infinite loop iterations: {iter}");

// --- 14. Deeply Nested Conditionals ---
var x = 5;
var y = 10;
var z = 15;
var result;
if (x > 0) {
    if (y > 0) {
        if (z > 0) {
            result = "positive";
        } else {
            result = "mixed";
        }
    } else {
        result = "negative y";
    }
} else {
    result = "negative x";
}
print("14. Deep nested: {result}");

// --- 15. Loop with Variable Conditions ---
var cond_val = 100;
while (cond_val > 0) {
    cond_val = cond_val - 7;
}
print("15. 100 mod 7 = {cond_val} (should be 2)");

// --- 16. For Loop with Expression Step ---
var sum_step = 0;
for (var s = 0; s < 100; s = s + 7) {
    sum_step = sum_step + s;
}
print("16. Sum step 7 = {sum_step}");

// --- 17. Nested While ---
var rows = 0;
while (rows < 3) {
    var cols = 0;
    var row_sum = 0;
    while (cols < 4) {
        row_sum = row_sum + (rows * 4 + cols);
        cols = cols + 1;
    }
    rows = rows + 1;
}
print("17. Nested while computed");

// --- 18. Break from Inner to Outer ---
var found_pair = false;
var pair_i = 0;
var pair_j = 0;
for (var i = 0; i < 10; i = i + 1) {
    for (var j = 0; j < 10; j = j + 1) {
        if ((i + 1) * (j + 1) == 20) {
            pair_i = i + 1;
            pair_j = j + 1;
            found_pair = true;
            break;
        }
    }
    if (found_pair) {
        break;
    }
}
print("18. Found pair: {pair_i} x {pair_j} = {pair_i * pair_j}");

// --- 19. Conditional Expression in Loop ---
var odds = [];
for (var o = 1; o <= 20; o = o + 1) {
    if (o % 2 == 1) {
        odds.push(o);
    }
}
print("19. Odds to 20: {odds.len()} items");

// --- 20. Complex Loop Pattern ---
var collatz = 27;
var steps = 0;
loop {
    if (collatz == 1) {
        break;
    }
    if (collatz % 2 == 0) {
        collatz = collatz / 2;
    } else {
        collatz = 3 * collatz + 1;
    }
    steps = steps + 1;
}
print("20. Collatz(27) steps = {steps}");

print("");
print("=== CONTROL FLOW TESTS PASSED ===");
