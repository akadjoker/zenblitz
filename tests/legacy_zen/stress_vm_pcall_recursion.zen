// stress: recursion depth, pcall nesting, error propagation
def rec(n) {
    if (n <= 0) { return 0; }
    return 1 + rec(n - 1);
}
print("rec200:", rec(200));

// Unbounded NON-tail recursion must fail gracefully under pcall, not
// segfault. `return infinite(n + 1);` alone (no arithmetic around the call)
// is a tail call — OP_TAILCALL reuses the current frame instead of growing
// the stack, so that shape runs forever by design (same as Lua/Scheme TCO)
// and must NOT be used here. The `1 + ...` forces a non-tail call so the
// frame stack actually grows and the depth limit kicks in.
def infinite(n) { return 1 + infinite(n + 1); }
var (ok, err) = pcall(infinite, 0);
print("deep-rec caught:", ok == false, err != nil);

// lock the exact call-stack depth limit into the snapshot: if the VM frame
// budget changes, this test flags it
var lo = 0;
var hi = 4096;
while (lo < hi) {
    var mid = (lo + hi + 1) div 2;
    var (okd, rd) = pcall(rec, mid);
    if (okd) { lo = mid; } else { hi = mid - 1; }
}
print("max-depth:", lo);

// mutual recursion (kept under the 254-frame limit)
def even(n) { if (n == 0) { return true; } return odd(n - 1); }
def odd(n) { if (n == 0) { return false; } return even(n - 1); }
print("mutual:", even(100), odd(101));

// nested pcall — inner error caught by inner, outer unaffected
def boom() { error("inner-boom"); }
def middle() {
    var (ok2, e2) = pcall(boom);
    return "mid-saw:" + (ok2 ? "ok" : "err");
}
var (ok3, res3) = pcall(middle);
print("nested-pcall:", ok3, res3);

// pcall of pcall of error
var (ok4, res4) = pcall(def() {
    var (ok5, e5) = pcall(def() { error("lvl2"); });
    if (!ok5) { error("rethrown"); }
    return "unreached";
});
print("rethrow:", ok4 == false);

// error with non-string-ish message path
var (ok6, e6) = pcall(def() { error("msg-" + 42); });
print("errmsg:", ok6 == false, e6);

// pcall returning multiple values from success
def multi() { return 1, 2, 3; }
var (ok7, r7) = pcall(multi);
print("multi-ok:", ok7, r7);

// deep pcall nesting (16 levels)
def nest(n) {
    if (n <= 0) { error("bottom"); }
    var (o, e) = pcall(nest, n - 1);
    if (!o) { error("up-" + n); }
    return 0;
}
var (ok8, e8) = pcall(nest, 16);
print("pcall16:", ok8 == false, e8);

// closures surviving pcall failure
var counter = 0;
var bump = def() { counter += 1; error("after-bump"); };
pcall(bump);
pcall(bump);
print("closure-state:", counter);
