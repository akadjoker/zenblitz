// --- 39. CLASS WITH SELF-REFERENTIAL METHODS ---
class Counter2 {
    var count;
    def init() {
        self.count = 0;
    }
    def bump() {
        self.count = self.count + 1;
        return self;
    }
    def reset() {
        self.count = 0;
        return self;
    }
    def value() {
        return self.count;
    }
}
var c2 = Counter2();
c2.bump().bump().bump();
print("39. Self-ref: {c2.value()}");
c2.reset().bump();
print("   after reset+bump: {c2.value()}");

// --- 40. ARRAY PUSH MULTIPLE ARGS ---
