// --- 29. MULTI-VALUE RETURN (via array) ---
def min_max(arr) {
    var mn = arr[0];
    var mx = arr[0];
    for (var i = 1; i < arr.len(); i = i + 1) {
        if (arr[i] < mn) mn = arr[i];
        if (arr[i] > mx) mx = arr[i];
    }
    return [mn, mx];
}
var res = min_max([3, 1, 4, 1, 5, 9, 2, 6]);
print("29. Multi-return: min={res[0]} max={res[1]}");

