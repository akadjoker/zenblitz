// --- 9. CLASSES - BASIC ---
class Contador {
    var valor;
    def init() {
        self.valor = 0;
    }
    def incrementar() {
        self.valor = self.valor + 1;
    }
    def obter() {
        return self.valor;
    }
}
var c = Contador();
c.incrementar();
c.incrementar();
print("9. Classes basic: contador = {c.obter()}");

// --- 10. CLASSES WITH INIT PARAMS ---
class Vec2 {
    var x;
    var y;
    def init(x, y) {
        self.x = x;
        self.y = y;
    }
    def somar(outro) {
        return Vec2(self.x + outro.x, self.y + outro.y);
    }
    def magnitude() {
        return sqrt(self.x * self.x + self.y * self.y);
    }
    def dist(to) {
        return sqrt((self.x - to.x) * (self.x - to.x) + (self.y - to.y) * (self.y - to.y));
    }
}
var v1 = Vec2(3, 4);
var v2 = Vec2(1, 2);
var soma2 = v1.somar(v2);
print("10. Classes init: Vec2({soma2.x}, {soma2.y}) mag={v1.magnitude()}");

// --- 11. CLASS COMPOSITION ---
class Timer {
    var duracao;
    var restante;
    def init(duracao) {
        self.duracao = duracao;
        self.restante = duracao;
    }
    def update(dt) {
        self.restante = self.restante - dt;
        if (self.restante < 0) { self.restante = 0; }
        return self.restante <= 0;
    }
}
class Arma {
    var dano;
    var cooldown;
    def init(dano, tempo) {
        self.dano = dano;
        self.cooldown = Timer(tempo);
    }
    def disparar() {
        if (self.cooldown.update(0) || self.cooldown.restante <= 0) {
            self.cooldown.restante = self.cooldown.duracao;
            print("   BANG! dano={self.dano}");
            return true;
        }
        return false;
    }
}
var arma = Arma(25, 0.5);
arma.disparar();
arma.disparar();
arma.cooldown.update(0.6);
arma.disparar();

// --- 12. SELF AS RETURN (method chaining) ---
class Builder {
    var val;
    def init(v) {
        self.val = v;
    }
    def add(n) {
        self.val = self.val + n;
        return self;
    }
    def mul(n) {
        self.val = self.val * n;
        return self;
    }
    def get() {
        return self.val;
    }
}
var b = Builder(10);
b.add(5).mul(2);
print("12. Method chain: {b.get()}");  // 30

// --- 13. CLOSURES ---
def make_counter() {
    var n = 0;
    def inc() {
        n = n + 1;
        return n;
    }
    return inc;
}
var cnt = make_counter();
print("13. Closures: {cnt()} {cnt()} {cnt()}");

// --- 14. CLOSURE CAPTURE (multiple independent) ---
def make_adder(n) {
    def add(x) {
        return x + n;
    }
    return add;
}
var add10 = make_adder(10);
var add5 = make_adder(5);
print("14. Closure capture: add10(5)={add10(5)} add5(5)={add5(5)}");

// --- 15. ANONYMOUS FUNCTIONS ---
var sq = def(x) { return x * x; };
print("15. Anonymous: sq(7) = {sq(7)}");

// --- 16. FIRST-CLASS FUNCTIONS ---
def apply(f, x) {
    return f(x);
}
print("16. First-class: apply(sq, 6) = {apply(sq, 6)}");

// --- 17. FIBERS ---
def fib_gen() {
    var a = 0;
    var b = 1;
    loop {
        yield a;
        var t = a;
        a = b;
        b = t + b;
    }
}
var fg = spawn fib_gen;
print("17. Fibers: {resume(fg)} {resume(fg)} {resume(fg)} {resume(fg)} {resume(fg)}");

// --- 18. FIBER WITH YIELD VALUE ---
def accumulator() {
    var soma = 0;
    loop {
        var v = yield soma;
        soma = soma + v;
    }
}
var ac = spawn accumulator;
resume(ac);
print("18. Fiber yield-value: {resume(ac, 10)} {resume(ac, 20)} {resume(ac, 30)}");

