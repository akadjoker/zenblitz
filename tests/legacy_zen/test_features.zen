// --- 3. COMPARISON ---
print("3. Comparison: {10 == 10} {10 != 5} {10 > 5} {10 < 5} {10 >= 10} {10 <= 9}");

// --- 4. LOGICAL ---
print("4. Logical: {true && false} {true || false} {!true}");

// --- 5. COMPOUND ASSIGNMENT ---
var x = 10;
x += 5;
x -= 2;
x *= 3;
